# Copie este arquivo para .env e preencha com os dados desta maquina.
# Nunca versione o .env com credenciais reais.

# Servidor da API
PORT=3010

# Conexao PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=0
DB=reabilitah

# Manter desativado; usar migrations para alterar a estrutura do banco.
DB_SYNCHRONIZE=false
